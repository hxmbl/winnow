<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- navigator.vibrate() for swipe and long-press haptics; a normal permission, granted at install. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Self-update (update/UpdatePlugin.kt): hand a downloaded release APK to the package
      installer. Android still shows its own confirmation, and on 8+ asks the user once
      to allow "Install unknown apps" for Winnow.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      Sign-in keep-alive (signin/SignInKeepAliveService.kt): a short foreground service
      while the user is at Google, so Android does not freeze Winnow and the loopback
      listener can answer the redirect. shortService needs no type-specific permission.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      Background sync (sync/MailSyncService.kt): a foreground service with a silent,
      low-importance notification keeps Winnow checking Gmail with the app closed.
      specialUse rather than dataSync: Android 15 caps dataSync at 6 hours a day and will
      not start it on boot. New-mail notifications need POST_NOTIFICATIONS (Android 13+);
      the network callback needs ACCESS_NETWORK_STATE; a check holds a short wake lock;
      BOOT_COMPLETED starts it again after a restart; and Settings can offer Android's own
      "let it run in the background" dialog. Winnow is not on Google Play, so the Play
      policy on that dialog does not apply.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      "Instant mail via the Gmail app" (sync/GmailNotificationListener.kt) checks whether
      the Gmail app is installed; Android 11+ hides other packages unless they are named.
    -->
    <queries>
        <package android:name="com.google.android.gm" />
    </queries>

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!--
      No backup, to the cloud or to a new phone. The app's data is somebody's mail: the
      WebView's storage holds the offline cache, contacts and drafts in plain text, and
      the Keystore-wrapped secrets are useless off this device anyway. allowBackup covers
      Android 11 and older; dataExtractionRules is what 12+ reads, and the only way to
      stop device-to-device transfer.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.winnow"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!--
              winnow:// links. The sign-in success page (oauth.rs) links to
              winnow://signed-in so one tap brings this single-task activity back in
              front of the browser, where the code exchange is waiting for it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="winnow" />
            </intent-filter>
        </activity>

        <!--
          Notification buttons (Reply, Delete, Mark read, Undo). Not exported: only the
          PendingIntents Winnow itself posts can reach it. See notify/MailNotifier.kt.
        -->
        <!-- Runs only while a browser sign-in is open; see signin/SignInKeepAliveService.kt. -->
        <service
            android:name=".signin.SignInKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <receiver
            android:name=".notify.NotifyActionReceiver"
            android:exported="false" />

        <!--
          Background sync: checks Gmail every 5 minutes (10 while the Gmail-app listener below
          is connected) while Winnow is closed and posts
          new-mail notifications (sync/MailSyncService.kt). Runs only while Settings →
          Notifications &amp; sync → "Keep syncing while closed" and notifications are on.
        -->
        <service
            android:name=".sync.MailSyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps an email client checking the user's mailbox for new mail while the app is closed, so new-mail notifications arrive promptly (the user turns this on in Settings; the app has no push server)." />
        </service>

        <!--
          "Instant mail via the Gmail app" (Settings, Notifications and sync; off by default):
          when the Gmail app posts a notification, check straight away and take Gmail's copy
          down once Winnow has posted its own. Android binds it only after the user grants
          Notification access by hand; BIND_NOTIFICATION_LISTENER_SERVICE means only the
          system can bind it. Android has no per-package filter an app can declare, so the
          code drops every notification that is not com.google.android.gm before reading it;
          the filter types below at least keep ongoing ones (music, calls, navigation) away
          on Android 12+. See sync/GmailNotificationListener.kt.
        -->
        <service
            android:name=".sync.GmailNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting|silent" />
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="ongoing" />
        </service>

        <!-- Starts background sync again after a reboot or an update, if it was on. -->
        <receiver
            android:name=".sync.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

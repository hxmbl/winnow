{
  "name": "winnow-web",
  "private": true,
  "version": "1.7.3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm run lint && npm run lint:proxy && npm run test",
    "smoke": "npm run build && node scripts/smoke.mjs && node scripts/smoke-android.mjs && node scripts/smoke-filters.mjs && node scripts/smoke-notifications.mjs && node scripts/smoke-accounts.mjs",
    "leaks": "npm run build && node scripts/leaks.mjs",
    "sweep": "npm run build && node scripts/sweep.mjs",
    "tauri:dev": "cd ../native && cargo tauri dev",
    "tauri:build": "node scripts/bundle.mjs",
    "proxy": "node --experimental-strip-types ../proxy/server.ts",
    "lint:proxy": "cd .. && web/node_modules/.bin/eslint --config web/eslint.proxy.config.mjs proxy"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.469.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.65.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}

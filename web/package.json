{
  "name": "winnow-web",
  "private": true,
  "version": "1.10.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --config .oxlintrc.json .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm run lint && npm run lint:proxy && npm run test",
    "smoke": "npm run build && node scripts/smoke.mjs && node scripts/smoke-android.mjs && node scripts/smoke-filters.mjs && node scripts/smoke-notifications.mjs && node scripts/smoke-accounts.mjs",
    "leaks": "npm run build && node scripts/leaks.mjs",
    "sweep": "npm run build && node scripts/sweep.mjs",
    "tauri:dev": "cd ../native && cargo tauri dev",
    "tauri:build": "node scripts/bundle.mjs",
    "proxy": "node --experimental-strip-types ../proxy/server.ts",
    "lint:proxy": "cd .. && web/node_modules/.bin/oxlint --config .oxlintrc.proxy.json proxy"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^31.0.1",
    "oxlint": "^1.95.0",
    "playwright": "^1.65.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
